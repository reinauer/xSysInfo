From 19f91eac2debe6085794203c541ffcf098181f03 Mon Sep 17 00:00:00 2001
From: Stefan Reinauer <stefan.reinauer@coreboot.org>
Date: Wed, 17 Jun 2026 07:32:56 -0700
Subject: [PATCH] update-pci: drop empty PCI vendors

The PCI ID source includes manufacturer records without any products.
Keeping them only lets the generated database name an unknown vendor,
while still adding table records and strings to S:pci.db.

Prune those empty manufacturer buckets after parsing and include the
removed count in the generator statistics.
---
 update-pci.py | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/update-pci.py b/update-pci.py
index f466015..166c744 100755
--- a/update-pci.py
+++ b/update-pci.py
@@ -62,6 +62,15 @@ def newProduct(id, name):
         return
     products[currentManuf][id] = name
 
+def removeEmptyManufacturers():
+    emptyManufacturers = [
+        id for id, prodList in products.items() if len(prodList) == 0
+    ]
+    for id in emptyManufacturers:
+        del products[id]
+        del manufacturers[id]
+    return len(emptyManufacturers)
+
 def newClass(id, name):
     global classes
     classes[id] = name
@@ -153,6 +162,8 @@ with open("pciids/pci.ids") as file:
         if vc:
             newClass(int(vc.group(1), 16), vc.group(2))
 
+emptyManufCount = removeEmptyManufacturers()
+
 print("-- Generating Database Source --")
 writeDatabase("src/identify/pci/database.s")
 
@@ -173,4 +184,5 @@ print("  Manufacturers:  {}".format(len(manufacturers)))
 print("  Products:       {}".format(prodCount))
 print("  PCI Classes:    {}".format(len(classes)))
 print("  Max Str Length: {}".format(strLen))
+print("  Empty Removed:  {}".format(emptyManufCount))
 print()
